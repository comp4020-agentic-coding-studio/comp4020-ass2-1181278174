---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
import Record from "../components/Record.astro";
import { withBase } from "astro-theme-university/url";
import HomeCorridor from "../components/HomeCorridor.astro";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="Slop Hill as flat gold and black shapes: a kitchen at the foot, two towers on the slope with a gap between them, small houses, a solid line straight up the ridge and a dashed line around the contour to the house at the top, two drones in the air"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <p class="home-lead">Build a planner that can deliver twenty dinners and bring every drone home. Start with one route, then add energy, deadlines, charging and shared airspace over twelve weeks.</p>
  <p><strong>For:</strong> third-year students with programming and data structures. <strong>Each week:</strong> one lecture and a two-hour tutorial. <strong>Assessment:</strong> two individual assignments, 40% and 60%.</p>
  <nav class="home-actions" aria-label="Start exploring the course">
    <a href={withBase("/sessions/")}>Explore the 12 weeks →</a>
    <a href={withBase("/lab/#lab-w4")}>Try the route experiment →</a>
    <a href={withBase("/assessments/")}>View the assignments →</a>
  </nav>
  <h2>One decision to try now</h2>
  <p>Two drones want the same narrow corridor. Change the arrangement and watch the conflict, wait and arrival time change.</p>
  <HomeCorridor />
  <Record compact />
  <h2>Three orders you will keep meeting</h2>
  <ul>
    <li><strong>#07, mapo tofu for the house on the hilltop.</strong> Far and urgent. The
      ridge route is fastest and burns the return energy; the contour route is slower and
      gets back.</li>
    <li><strong>#13, the house across the corridor.</strong> Its shortest route passes the
      one gap on the hill that only one drone can use at a time.</li>
    <li><strong>#20, hotpot for four.</strong> Only the heavy drone type can carry it, which
      decides who takes it before anything about efficiency is discussed.</li>
  </ul>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title="Lab" href="/lab/">
      <p>Choose a week, keep a baseline and export your experiment record.</p>
    </Card>
    <Card title="Lectures" href="/lectures/">
      <p>Twelve Monday lectures, one question each, from a graph to a plan that flies.</p>
    </Card>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>Twelve Wednesday tutorials: predict, derive, implement, test, explain.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>The two assignments, their dates, weights and marking criteria.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>The convenor and the tutor, and who to ask about what.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .home-lead { font-size: 1.2rem; }
  .home-actions { display: flex; flex-wrap: wrap; gap: 0.65rem 1.4rem; margin-block: 1.2rem 2rem; }
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
