---
import BaseLayout from 'astro-theme-university/layouts/BaseLayout.astro';
import hero from '../assets/images/hero-home.avif';
import { courseMeta } from '../course-config';
import { siteConfig } from '../site-config';
import { withBase } from 'astro-theme-university/url';
import HillWalk from '../components/HillWalk.astro';
import SemesterTimeline from '../components/SemesterTimeline.astro';
import HomeCorridor from '../components/HomeCorridor.astro';
import Record from '../components/Record.astro';
const opening = courseMeta.description.match(/^.*?[.!?](?:\s|$)/)?.[0].trim() ?? courseMeta.description;
---
<BaseLayout title={`${courseMeta.code}: ${courseMeta.title}`} description={courseMeta.description} {...siteConfig} mainAttrs={{ class: 'home-main' }}>
  <section slot="hero" class="home-hero" aria-labelledby="home-title">
    <img src={hero.src} width={hero.width} height={hero.height} fetchpriority="high" alt="Slop Hill in the evening, rendered from the course's delivery map." />
    <div class="hero-copy">
      <p class="hero-course">{courseMeta.code} · {courseMeta.title}</p>
      <h1 id="home-title">Twenty Dinners,<br />One Hill</h1>
      <p class="hero-description">{opening}</p>
      <div class="hero-actions">
        <a class="at-button at-button--large" href={withBase('/#hill')}>Walk the hill</a>
        <a class="at-button at-button--outline at-button--large" href={withBase('/lab/')}>Open the lab</a>
      </div>
      <a class="hero-weeks" href={withBase('/sessions/')}>Twelve weeks →</a>
    </div>
  </section>
  <HillWalk />
  <SemesterTimeline />
  <section aria-labelledby="home-corridor-title">
    <h2 id="home-corridor-title">One passage, two drones</h2>
    <HomeCorridor />
  </section>
  <Record compact />
</BaseLayout>
<style>
  .home-hero { grid-column: full; position: relative; isolation: isolate; display: flex; align-items: flex-end; justify-content: center; min-height: 38rem; height: calc(100dvh - var(--at-nav-height)); box-sizing: border-box; background: #353e48; color: #fffaf0; padding: 2rem 1.2rem 3.5rem; text-align: center; }
  .home-hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 43%; z-index: -2; }
  .home-hero::before { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, #111820f5 0%, #111820c9 24%, #11182020 76%); z-index: -1; }
  .hero-copy { max-width: 52rem; }
  .hero-course { font-size: .8rem; margin: 0 0 1rem; color: #f1d5a0; }
  .home-hero h1 { color: inherit; font-family: var(--at-font-body); font-size: clamp(2.5rem,5vw,4.7rem); line-height: 1.05; letter-spacing: -.045em; margin: 0; font-weight: 600; }
  .hero-description { margin: 1.1rem auto 1.4rem; font-size: 1.12rem; max-width: 34rem; }
  .hero-actions { display: flex; justify-content: center; gap: .75rem; }
  .hero-actions a { color: #fffaf0; border-color: #e1b761; background: #78500e; }
  .hero-actions .at-button--outline { background: #18212ad9; }
  .hero-actions a:hover { background: #936619; }
  .hero-weeks { display: inline-block; color: #f1d5a0; padding: .75rem; margin-top: .45rem; font-size: .9rem; }
  :global(body:has(.home-hero)::after) { display: none; }
  :global(.at-main.home-main) { grid-column: full; color-scheme: light; background: var(--at-bg); color: var(--at-text); display: block; padding: 2.5rem max(1rem,calc((100vw - 76rem)/2)) 4rem; }
  :global(.at-main.home-main::before) { display: none; }
  :global(.home-main > section), :global(.home-main > .record) { margin-block: 0 3rem; }
  @media(max-width:700px) {
    .home-hero { min-height: 36rem; padding: 1.5rem 1rem 1.7rem; }
    .home-hero > img { object-position: 66% 50%; }
    .hero-course { font-size: .68rem; }
    .hero-description { font-size: 1rem; }
    .hero-actions { flex-direction: column; }
    .hero-actions a { width: 100%; }
    .hero-copy { width: min(100%,26rem); }
  }
</style>
