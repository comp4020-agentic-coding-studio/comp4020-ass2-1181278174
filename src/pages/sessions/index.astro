---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`Twelve Wednesday ${sessionLabels.plural.toLowerCase()}: what to predict before, what happens in the two hours, and what you leave with.`}
  {...siteConfig}
>
  <p>
    Two hours each, the same shape every week: predict and compute by hand, derive or
    trace a small example, implement and compare, then test and explain. Every tutorial
    opens on its own with its case loaded, and later weeks are never locked behind earlier
    ones. Start with the computed example and its main comparison button. Expand the two-hour
    guide for preparation, coding and checks; expand the tools when you want to change
    more inputs. The page's spec states what you should be able to do by the end.
  </p>
  <SessionsGrid />
</ContentLayout>
