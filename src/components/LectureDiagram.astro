---
const { week } = Astro.props;
const flows: Record<number, { steps: string[]; caption: string }> = {
  1: { steps: ['Load', 'Fly out', 'Deliver', 'Fly back', 'Land'], caption: 'One complete task. Reaching the customer ends the loaded phase; landing at the kitchen ends the trip.' },
  5: { steps: ['Ready at 100', 'Load at 120', 'Depart at 180', 'Deliver at 270', 'Land at 330', 'Available at 390'], caption: 'Worked timetable in seconds. The drone becomes available at 120, loads for 60, delivers after 90 and lands after 150 seconds of flight and service.' },
  6: { steps: ['Start: (57,55)', 'Best swap: (48,55)', 'No better pair swap', 'Exact: (46,51)'], caption: 'Symbolic six-job example: each pair is (total lateness, final return). The exact result uses all 720 sequences, beyond one swap neighbourhood.' },
  7: { steps: ['Can it carry #20?', 'Can it return?', 'Predict delivery', 'Compare feasible drones'], caption: 'Capability before efficiency. A and B are light drones; D is heavy. The hotpot rules out the light pair before comparing delivery times.' },
  8: { steps: ['C requests at 5', 'Pad 1 releases at 10', 'C charges [10,16)', 'C is available at 16'], caption: 'Symbolic two-pad queue. Pad 2 remains occupied until 20. C waits five seconds on the ground for the earlier release.' },
  10: { steps: ['P at 3', 'Wait to 4, 5, 6', 'Cross [6,8)', 'G at 8'], caption: 'Symbolic waiting trace: an existing reservation ends at 6. Keeping time in the state preserves the legal waits.' },
  11: { steps: ['Propose a migration', 'Rebuild trips and queues', 'Check the full plan', 'Accept an improvement'], caption: 'Feedback loop: a changed assignment produces new route and resource costs. Each candidate starts with a fresh reservation table.' },
  12: { steps: ['Input and strategy', 'Run and check', 'Trace an order', 'Export and reproduce'], caption: 'The audit follows one record from its inputs to a claim another reader can reproduce.' },
};
const graphs: Record<number, { nodes: { id: string; x: number; y: number }[]; edges: [string,string,string][]; caption: string }> = {
  2: { nodes: [{id:'S',x:65,y:125},{id:'A',x:290,y:40},{id:'G',x:525,y:125}], edges:[['S','G','10'],['S','A','1'],['A','G','1']], caption:'Symbolic graph: S→G costs 10; S→A→G costs 1+1=2. Discovering G first does not finish the search.' },
  3: { nodes: [{id:'S',x:55,y:115},{id:'A',x:275,y:40},{id:'B',x:275,y:190},{id:'G',x:530,y:40}], edges:[['S','A','3'],['S','B','1'],['B','A','1'],['A','G','2']], caption:'Four directed edges. h(B)=3 and other h=0. B later improves A, so A must be reopened to return cost 4.' },
  4: { nodes: [{id:'S',x:55,y:115},{id:'ridge',x:270,y:40},{id:'contour',x:270,y:190},{id:'Q',x:530,y:115}], edges:[['S','ridge',''],['S','contour',''],['ridge','Q','(4,7)'],['contour','Q','(6,3)']], caption:'The two labels at Q are (time, energy), in symbolic units. Add the return (2,2) to each before checking the budget of 8.' },
};
const flow = flows[week], graph = graphs[week];
const arrowId = `lecture-arrow-${week}`;
---
<figure class="lesson-diagram">
  {graph ? <svg viewBox="0 0 590 235" role="img" aria-label={graph.caption}>
    <defs><marker id={arrowId} markerWidth="7" markerHeight="7" refX="6" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6" fill="currentColor" /></marker></defs>
    {graph.edges.map(([a,b,label]) => {
      const from=graph.nodes.find(n=>n.id===a)!, to=graph.nodes.find(n=>n.id===b)!;
      const angle=Math.atan2(to.y-from.y,to.x-from.x), inset=38;
      return <g><line x1={from.x+Math.cos(angle)*inset} y1={from.y+Math.sin(angle)*inset} x2={to.x-Math.cos(angle)*inset} y2={to.y-Math.sin(angle)*inset} stroke="currentColor" stroke-width="2" marker-end={`url(#${arrowId})`} /><text x={(from.x+to.x)/2+(a==='B'?22:0)} y={(from.y+to.y)/2-10} text-anchor="middle">{label}</text></g>;
    })}
    {graph.nodes.map(n=><g><rect x={n.x-37} y={n.y-23} width="74" height="46" rx="6" fill="var(--at-bg)" stroke="currentColor"/><text x={n.x} y={n.y+7} text-anchor="middle">{n.id}</text></g>)}
  </svg> : week === 9 ? <div class="intervals" role="img" aria-label="B occupies the corridor from 87 to 112; A from 107 to 132. The overlap is from 107 to 112."><p>B · <strong>[87,112)</strong></p><div class="lane"><span style="left:0%;width:55.56%">B</span></div><p>A · <strong>[107,132)</strong></p><div class="lane"><span style="left:44.44%;width:55.56%">A</span></div><p class="overlap">Shared time: [107,112) · 5 seconds</p></div> : <ol class="flow">{flow.steps.map(step=><li>{step}</li>)}</ol>}
  <figcaption>{graph?.caption ?? flow?.caption ?? 'Live corridor intervals, in seconds after A takes off. A may enter at 112 when B leaves.'}</figcaption>
</figure>
<style>
  .lesson-diagram { margin: 1.3rem 0; padding: 1rem; background: var(--at-bg-alt); border-left: 3px solid var(--at-primary); }
  svg { display: block; width: 100%; max-width: 650px; margin: auto; font: 22px system-ui; }
  figcaption { margin-top: .75rem; font-size: .95rem; line-height: 1.5; }
  .flow { display: flex; flex-wrap: wrap; gap: .8rem 1.6rem; padding: 0; list-style: none; counter-reset: step; }
  .flow li { flex: 1 1 150px; padding: .65rem; border: 1px solid var(--at-border); background: var(--at-bg); counter-increment: step; }
  .flow li::before { content: counter(step) '. '; font-weight: 700; }
  .lane { position: relative; height: 32px; background: var(--at-bg); }
  .lane span { position: absolute; height: 100%; background: var(--at-text); color: var(--at-bg); text-align: center; font-weight: 700; }
  .intervals p { margin: .5rem 0; } .overlap { font-weight: 700; }
</style>
