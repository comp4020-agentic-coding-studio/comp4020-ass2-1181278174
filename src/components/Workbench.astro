---
// One week's workbench instance. Rendered with its result at build time; the
// script below recomputes in the browser when a control changes, using the
// same case module.
import { withBase } from "astro-theme-university/url";
import { caseByKey, caseFor, renderControls } from "../workbench/cases";

interface Props {
  week?: number;
  case?: string;
  title?: string;
}
const { week = 0, case: key, title = "This week's workbench" } = Astro.props;
const def = key ? caseByKey(key) : caseFor(week);
if (!def) throw new Error(`no workbench case for ${key ?? `week ${week}`}`);
const state = def.initial(week);
const caption = def.caption(week);
const view = def.render(state, week);
const id = `wb-${key ?? `w${week}`}`;
---

<section class="workbench" data-week={week} data-case={def.key} data-state={JSON.stringify(state)} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  <p class="wb-caption"><strong>This week's decision:</strong> {caption.decision} <strong>What it breaks:</strong> {caption.breaks}</p>
  <div class="wb-controls" set:html={renderControls(def, state, week, id)} />
  <div class="wb-view" set:html={view.html} />
  <p class="wb-status" aria-live="polite">{view.status.replace("computed in your browser", "computed when this page was built")}</p>
  {week > 0 && !Astro.url.pathname.includes("/lab/") && <p class="wb-lab"><a href={withBase(`/lab/#lab-w${week}`)}>Open in the lab, with every other week</a></p>}
</section>

<script>
  import { caseByKey, renderControls } from "../workbench/cases";
  import { mapWidth, setMapWidth } from "../workbench/minimap";

  function wire(root: HTMLElement, signal: AbortSignal) {
    const week = Number(root.dataset.week);
    const def = caseByKey(root.dataset.case ?? "");
    if (!def) return;
    let state = JSON.parse(root.dataset.state ?? "null") ?? def.initial(week);
    // A deep link carries the state: ?wb-<case>=<json>. Every change writes it
    // back, so a state reached by hand can be handed to someone as a link.
    const param = `wb-${root.dataset.case}`;
    const fromUrl = new URL(location.href).searchParams.get(param);
    if (fromUrl) {
      try { state = { ...state, ...JSON.parse(fromUrl) }; } catch { /* not ours; ignore */ }
    }
    const controls = root.querySelector<HTMLElement>(".wb-controls")!;
    const view = root.querySelector<HTMLElement>(".wb-view")!;
    const status = root.querySelector<HTMLElement>(".wb-status")!;
    const id = `wb-${root.dataset.case}`;

    const update = (action: { id: string; value?: string }, focusId?: string) => {
      state = def.apply(state, action);
      const out = def.render(state, week);
      view.innerHTML = out.html;
      controls.innerHTML = renderControls(def, state, week, id);
      status.textContent = out.status;
      root.dataset.state = JSON.stringify(state);
      const url = new URL(location.href);
      url.searchParams.set(param, JSON.stringify(state));
      history.replaceState(history.state, "", url);
      if (focusId) controls.querySelector<HTMLElement>(`[data-control="${focusId}"]`)?.focus();
    };
    if (fromUrl) update({ id: "" });

    // The map is drawn for a 560 px column at build time. In a narrower column
    // (a phone) the same case is drawn again at the column's width, so the
    // labels keep their size; the URL and the state do not change.
    const refit = () => {
      const w = view.clientWidth;
      if (!w) return;
      const target = Math.min(560, w - 2);
      if (Math.abs(target - mapWidth()) < 24) return;
      setMapWidth(target);
      const out = def.render(state, week);
      view.innerHTML = out.html;
      status.textContent = out.status;
    };
    refit();
    let timer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener("resize", () => { clearTimeout(timer); timer = setTimeout(refit, 200); }, { signal });

    controls.addEventListener("click", (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLElement>("button[data-control]");
      if (!b) return;
      if (b.dataset.codeFrom) {
        const ta = controls.querySelector<HTMLTextAreaElement>(`textarea[data-code-for="${b.dataset.codeFrom}"]`);
        update({ id: b.dataset.control!, value: ta?.value ?? "" }, b.dataset.control);
      } else update({ id: b.dataset.control! }, b.dataset.control);
    }, { signal });
    controls.addEventListener("change", (ev) => {
      const s = (ev.target as HTMLElement).closest<HTMLSelectElement | HTMLInputElement>("select[data-control], input[data-control]");
      if (s) update({ id: s.dataset.control!, value: s.value }, s.dataset.control);
    }, { signal });
  }

  let aborter: AbortController | null = null;
  document.addEventListener("astro:page-load", () => {
    aborter?.abort();
    aborter = new AbortController();
    for (const root of document.querySelectorAll<HTMLElement>(".workbench[data-case]")) wire(root, aborter.signal);
  });
  document.addEventListener("astro:before-swap", () => aborter?.abort());
</script>

<style is:global>
  .workbench { margin-block: 1.5rem 2.5rem; padding: 1rem 1.25rem; border: 1px solid var(--at-border, #d9d2c3); border-radius: 0.5rem; background: var(--at-bg-alt, #f7f3ea); }
  .workbench h2 { margin-top: 0; }
  .wb-caption { margin-block: 0.25rem 1rem; }
  .wb-controls { display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; align-items: center; margin-block: 0.5rem 1rem; }
  .wb-control { font: inherit; }
  button.wb-control { padding: 0.45rem 0.9rem; border: 1px solid var(--at-primary, #b97d1c); border-radius: 0.35rem; background: transparent; color: inherit; cursor: pointer; }
  button.wb-primary { background: var(--at-primary, #b97d1c); color: #fff; }
  .wb-control select { font: inherit; padding: 0.3rem 0.4rem; }
  fieldset.wb-radios { border: 1px solid var(--at-border, #d9d2c3); border-radius: 0.35rem; padding: 0.4rem 0.8rem; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  fieldset.wb-primary-group { border-color: var(--at-primary, #b97d1c); }
  .wb-radios legend { font-weight: 600; padding-inline: 0.25rem; }
  .wb-radio { white-space: nowrap; }
  .timeline { display: block; width: 100%; max-width: 640px; margin-block: 0.5rem; }
  .tl-b { fill: #b93c1e; opacity: 0.6; }
  .tl-a { fill: #2f7d32; opacity: 0.7; }
  .tl-a.tl-bad { fill: #b93c1e; }
  .tl-conflict { fill: #b93c1e; opacity: 0.18; }
  .tl-axis { stroke: #6b6154; stroke-width: 1; }
  .wb-summary { font-size: 1.05rem; }
  .wb-table { overflow-x: auto; margin-block: 0.75rem; }
  .wb-table table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .wb-table caption { text-align: left; font-weight: 600; padding-block: 0.25rem; }
  .wb-table th, .wb-table td { padding: 0.3rem 0.5rem; border-bottom: 1px solid var(--at-border, #d9d2c3); text-align: left; vertical-align: top; }
  .wb-table .num { text-align: right; font-variant-numeric: tabular-nums; }
  .wb-table tr.wb-bad td { background: rgba(185, 60, 30, 0.12); }
  .wb-table tr.wb-good td { background: rgba(60, 140, 60, 0.12); }
  .wb-status { font-size: 0.85rem; color: var(--at-text-secondary, #6b6154); margin-block: 0.5rem 0; }
  .wb-lab { margin-block: 0.5rem 0; font-size: 0.95rem; }
  .wb-code { flex-basis: 100%; }
  .wb-code textarea { display: block; width: 100%; max-width: 40rem; font-family: var(--font-roboto-mono, monospace); font-size: 0.9rem; padding: 0.4rem; margin-block: 0.3rem; }
  .wb-error { color: #b93c1e; }
  .map-figure { margin: 0.75rem 0 1rem; }
  .minimap { display: block; width: 100%; height: auto; border: 1px solid var(--at-border, #d9d2c3); border-radius: 0.35rem; }
  .minimap-small { max-width: 360px; background: var(--at-bg, #fffdf8); }
  .map-legend { display: flex; flex-wrap: wrap; gap: 0.3rem 1.1rem; font-size: 0.9rem; margin-top: 0.45rem; }
  .map-legend i { display: inline-block; width: 1.6rem; border-top: 3px solid var(--c, #2b2520); vertical-align: middle; margin-right: 0.4rem; }
  .map-key { font-size: 0.8rem; color: var(--at-text-secondary, #6b6154); margin: 0.3rem 0 0; }
  .mm-bg { fill: transparent; }
  .mm-building { fill: #6b6154; opacity: 0.35; }
  .mm-tower { opacity: 0.7; }
  .mm-edge { fill: none; stroke: #b3a993; stroke-linecap: round; }
  .mm-corridor { stroke: #b97d1c; stroke-dasharray: 18 12; }
  .mm-route { fill: none; stroke: #2b2520; stroke-linecap: round; stroke-linejoin: round; }
  .mm-route.route-chosen { stroke: #2f7d32; }
  .mm-route.route-fastest { stroke: #b93c1e; stroke-dasharray: 22 12; }
  .mm-route.route-proposal { stroke: #b97d1c; stroke-dasharray: 22 12; }
  .mm-route.route-found { stroke: #6b6154; }
  .mm-node { fill: #fffdf8; stroke: #2b2520; stroke-width: 3; }
  .mm-marked { fill: #2b2520; }
  .mm-open { stroke: #b97d1c; stroke-width: 6; }
  .mm-onpath { stroke: #2f7d32; }
  .mm-kitchen, .mm-summit { fill: #b97d1c; }
  .mm-label { fill: #2b2520; font-family: inherit; }
  .mm-nodelabel { fill: #fffdf8; font-weight: 700; }
  .mm-node.mm-marked + .mm-nodelabel { fill: #fffdf8; }
  .minimap-small .mm-node:not(.mm-marked) + .mm-nodelabel { fill: #2b2520; }
</style>
