---
import { withBase } from 'astro-theme-university/url';
import heroImage from '../assets/images/hero-home.avif';
import { courseMeta } from '../course-config';
import { signs } from '../data/hill-stops';

const description = courseMeta.description.match(/^[^.!?]+[.!?]/)?.[0] ?? courseMeta.description;
const lab = signs.find(sign => sign.section === 'Lab')!.href;
const tutorials = signs.find(sign => sign.section === 'Tutorials')!.href;
---

<div class="home-opening" data-home-opening>
  <section class="home-opening-frame" aria-labelledby="home-title">
    <div class="home-opening-landscape">
      <img
        class="home-opening-poster"
        src={heroImage.src}
        width={heroImage.width}
        height={heroImage.height}
        alt="Slop Hill at dusk, with the kitchen below, homes along the hillside and a narrow passage between two towers."
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="home-opening-shade" aria-hidden="true"></div>
    <div class="home-opening-dimmer" aria-hidden="true"></div>
    <div class="home-opening-copy">
      <p class="home-opening-eyebrow">{courseMeta.code} · {courseMeta.title}</p>
      <h1 id="home-title">{courseMeta.title}</h1>
      <p class="home-opening-description">{description}</p>
      <div class="home-opening-actions">
        <div class="home-opening-buttons">
          <a class="home-opening-button home-opening-walk" href={withBase('/hill/')}>Walk the hill <span aria-hidden="true">↗</span></a>
          <a class="home-opening-button home-opening-lab" href={withBase(lab)}>Open the lab <span aria-hidden="true">→</span></a>
        </div>
        <a class="home-opening-weeks" href={withBase(tutorials)}>Twelve weeks <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <p class="home-opening-scroll-hint" aria-hidden="true"><span>↓</span> Scroll</p>
  </section>
</div>

<script>
  let disposeOpening = () => {};

  function mountOpening() {
    disposeOpening();
    disposeOpening = () => {};
    const opening = document.querySelector<HTMLElement>('[data-home-opening]');
    const frame = opening?.querySelector<HTMLElement>('.home-opening-frame');
    const poster = frame?.querySelector<HTMLImageElement>('.home-opening-poster');
    if (!opening || !frame || !poster) return;

    opening.dataset.homeEnhanced = '';
    const allowed = matchMedia('(min-width: 900px) and (any-pointer: fine) and (prefers-reduced-motion: no-preference)');
    const abort = new AbortController();
    const { signal } = abort;
    let pending = 0, visible = true, x = 0, y = 0;
    const reset = () => {
      cancelAnimationFrame(pending);
      pending = 0;
      poster.style.removeProperty('transform');
    };
    const move = (event: PointerEvent) => {
      if (!visible || !allowed.matches || event.pointerType !== 'mouse') return;
      x = (event.clientX / innerWidth * 2 - 1) * -12;
      y = (event.clientY / innerHeight * 2 - 1) * -8;
      if (!pending) pending = requestAnimationFrame(() => {
        poster.style.transform = `translate3d(${x}px, ${y}px, 0) scale(1.035)`;
        pending = 0;
      });
    };
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (!visible) reset();
    });
    observer.observe(frame);
    frame.addEventListener('pointermove', move, { signal, passive: true });
    frame.addEventListener('pointerleave', reset, { signal });
    frame.addEventListener('focusin', event => {
      if ((event.target as HTMLElement).matches(':focus-visible') && scrollY > 0) {
        opening.scrollIntoView({ block: 'start', behavior: 'instant' });
      }
    }, { signal });
    allowed.addEventListener('change', reset, { signal });
    document.addEventListener('visibilitychange', () => { if (document.hidden) reset(); }, { signal });
    disposeOpening = () => {
      abort.abort();
      observer.disconnect();
      reset();
      delete opening.dataset.homeEnhanced;
    };
  }

  document.addEventListener('astro:page-load', mountOpening);
  document.addEventListener('astro:before-swap', () => {
    disposeOpening();
    disposeOpening = () => {};
  });
  mountOpening();
</script>
