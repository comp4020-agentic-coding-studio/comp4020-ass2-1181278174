---
import { defaultConfig } from '../lab/model';
import { runExperiment } from '../lab/compute';
import { workspaceHtml } from '../lab/render';
import '../lab/lab.css';
interface Props { week?: number; semester?: boolean; compact?: boolean }
const { week=4, semester=false, compact=false }=Astro.props;
const run=runExperiment(defaultConfig(week));
---
<div class="lab-workspace" data-lab-workspace data-semester={String(semester)} data-compact={String(compact)}>
  <script is:inline type="application/json" data-initial-run set:html={JSON.stringify(run).replace(/</g,'\\u003c')} />
  <div data-workspace-content set:html={workspaceHtml(run,semester,compact)} />
  <noscript><p>The default experiment above was computed at build time. Enable JavaScript to change inputs, step through the search, save a record or load 3D. The result tables and 2D map remain readable.</p></noscript>
</div>
<script>
  import '../lab/client';
</script>
