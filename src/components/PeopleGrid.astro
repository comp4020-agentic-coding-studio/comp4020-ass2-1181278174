---
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import { withBase } from "astro-theme-university/url";

const people = await getPublishedCollection("people");

const roleOrder: Record<string, number> = {
  convenor: 0,
  tutor: 1,
  guest: 2,
  other: 3,
};

// Map the role enum (convenor|tutor|guest|other) to display labels rather than
// rendering the raw lowercase value.
const roleLabels: Record<string, string> = {
  convenor: "Convenor",
  tutor: "Tutor",
  guest: "Guest lecturer",
  other: "",
};

// photoAlt rides the schema's passthrough (definePeopleCollection has no
// extension point), so it needs a cast out of the generated types.
function photoAlt(data: unknown): string | undefined {
  const alt = (data as { photoAlt?: unknown }).photoAlt;
  return typeof alt === "string" ? alt : undefined;
}

const visible = people.sort((a, b) => {
  const ra = roleOrder[a.data.role ?? "other"] ?? 99;
  const rb = roleOrder[b.data.role ?? "other"] ?? 99;
  if (ra !== rb) return ra - rb;
  return a.data.title.localeCompare(b.data.title);
});
---

<div class="people-cards">
<CardGrid columns={2}>
  {
    visible.map((person) => (
      <Card
        headingLevel="h2"
        title={person.data.title}
        href={withBase(`/people/${person.id}/`)}
        image={person.data.photo ?? undefined}
        imageAlt={photoAlt(person.data)}
        imageWidths={[320, 640]}
        imageSizes="(min-width: 48rem) 24rem, calc(100vw - 3rem)"
        imageFormat="avif"
      >
        {person.data.role && roleLabels[person.data.role] && (
          <p class="person-role">{roleLabels[person.data.role]}</p>
        )}
        <p>{person.data.description}</p>
        <span class="person-more">Meet {person.data.title.split(" ")[0]} <span aria-hidden="true">→</span></span>
      </Card>
    ))
  }
</CardGrid>
</div>

<style>
  .people-cards { margin-block: 1rem 2rem; }
  .people-cards :global(.at-card-image-frame) { aspect-ratio: 1; background: #f6eed8; }
  .people-cards :global(.at-card-image) { width: 100%; height: 100%; object-fit: cover; }
  .people-cards :global(.at-card-body) { padding-top: 1.2rem; }
  .people-cards :global(.at-card-title) { font-size: 1.45rem; line-height: 1.25; }
  .person-role { margin-block: .45rem .8rem; font-weight: 600; color: var(--at-text-secondary); }
  .person-more { display: inline-block; margin-top: .45rem; color: var(--at-link); font-weight: 600; }
  @media (prefers-reduced-motion: reduce) {
    .people-cards :global(.at-card-image) { transition: none; transform: none; }
    .people-cards :global(a.at-card:hover .at-card-image) { transform: none; }
  }
</style>
